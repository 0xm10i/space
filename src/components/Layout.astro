---
import '../styles/global.css';
import MorphingSiteTitle from './MorphingSiteTitle.astro';
import { profile } from '../data/profile';

interface Props {
	title?: string;
	description?: string;
	showBlogNav?: boolean;
}

const {
	title = profile.name,
	description = profile.bio,
	showBlogNav = false,
} = Astro.props;

const pageTitle = title === profile.name ? `${profile.name} · m10i.space` : `${title} · m10i.space`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Space+Grotesk:wght@400;500;600&display=swap"
			rel="stylesheet"
		/>
		<title>{pageTitle}</title>
	</head>
	<body>
		<header class="site-header">
			<div class="site-header__inner">
				<MorphingSiteTitle />
				<nav class="site-nav" aria-label="Main">
					<a href="/" aria-current={Astro.url.pathname === '/' ? 'page' : undefined}>Home</a>
					<a
						href="/bass-tools/"
						aria-current={Astro.url.pathname.startsWith('/bass-tools') ? 'page' : undefined}
					>
						Bass Tools
					</a>
					{showBlogNav && (
						<a href="/blog" aria-current={Astro.url.pathname.startsWith('/blog') ? 'page' : undefined}>
							Blog
						</a>
					)}
					<a href={profile.links[0]?.href ?? 'https://github.com'} rel="noopener noreferrer">GitHub</a>
				</nav>
			</div>
		</header>
		<main>
			<slot />
		</main>
		<footer class="site-footer">
			<p>{profile.name} · <a href="https://m10i.space">m10i.space</a></p>
		</footer>
	</body>
</html>
