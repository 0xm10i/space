---
import '../styles/global.css';
import MorphingSiteTitle from './MorphingSiteTitle.astro';
import { profile } from '../data/profile';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = profile.name,
	description = profile.bio,
} = Astro.props;

const pageTitle = title === profile.name ? `${profile.name} · m10i.space` : `${title} · m10i.space`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<link rel="preload" href="/fonts/3270-regular.ttf" as="font" type="font/ttf" crossorigin />
		<title>{pageTitle}</title>
	</head>
	<body>
		<header class="site-header">
			<div class="site-header__inner">
				<MorphingSiteTitle />
				<nav class="site-nav" aria-label="Main">
					<a href="/" aria-current={Astro.url.pathname === '/' ? 'page' : undefined}>Home</a>
					<a href={profile.links[0]?.href ?? 'https://github.com'} rel="noopener noreferrer">GitHub</a>
				</nav>
			</div>
		</header>
		<main>
			<slot />
		</main>
		<footer class="site-footer">
			<p>{profile.name} · <a href="https://m10i.space">M10i.space</a></p>
		</footer>
	</body>
</html>
