---
import { EXPANDED_TITLE } from '../data/titleMorph';
---

<h1 class="morphing-hero-title" aria-label={EXPANDED_TITLE}>
	<span data-morphing-hero-title class="morphing-hero-title__text">{EXPANDED_TITLE}</span>
</h1>

<script>
	import { initMorphingHeroTitle } from '../scripts/morphingHeroTitle';

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', () => initMorphingHeroTitle(), { once: true });
	} else {
		initMorphingHeroTitle();
	}
</script>
