---
import type { CollectionEntry } from 'astro:content';

interface Props {
	posts: CollectionEntry<'blog'>[];
}

const { posts } = Astro.props;
---

{posts.length === 0 ? (
	<p class="empty-state">No posts yet. Add markdown files under <code>src/content/blog/</code>.</p>
) : (
	<ul class="post-list">
		{posts.map((post) => (
			<li>
				<a href={`/blog/${post.slug}/`}>
					{post.data.title}
				</a>
				<br />
				<time datetime={post.data.pubDate.toISOString()}>
					{post.data.pubDate.toLocaleDateString('en-US', {
						year: 'numeric',
						month: 'short',
						day: 'numeric',
					})}
				</time>
			</li>
		))}
	</ul>
)}
