---
import Layout from '../../components/Layout.astro';
import '../../styles/bass-tools.css';

const description =
	'Chromatic tuner, metronome, and drum machine for bass.';
---

<Layout title="Bass Tools" description={description}>
	<section id="view-home" class="view view-active">
		<header class="page-intro">
			<h1>Bass Tools</h1>
			<p class="page-intro__desc">Chromatic tuner, metronome, and drum machine for bass.</p>
			<div class="home-actions">
				<button type="button" id="btn-tuner" class="btn btn-secondary">Tuner</button>
				<button type="button" id="btn-metronome" class="btn btn-secondary">Metronome</button>
				<button type="button" id="btn-drum" class="btn btn-secondary">Drum machine</button>
			</div>
		</header>
	</section>

	<section id="view-tuner" class="view" hidden>
		<div class="card tuner-card">
			<div class="progress-row">
				<span class="tuner-title">Chromatic tuner</span>
				<button type="button" id="btn-tuner-back" class="btn btn-secondary btn-small">Back</button>
			</div>
			<p id="tuner-note" class="tuner-note" aria-live="polite">—</p>
			<p id="tuner-cents" class="tuner-cents" aria-live="polite"></p>
			<p id="tuner-freq" class="tuner-freq" aria-live="polite"></p>
			<div class="tuner-gauge" aria-hidden="true">
				<div class="tuner-center"></div>
				<div id="tuner-needle" class="tuner-needle"></div>
			</div>
			<div class="meter-wrap">
				<label class="meter-label">Mic level</label>
				<div class="meter">
					<div id="tuner-meter" class="meter-fill"></div>
					<div id="tuner-gate-mark" class="meter-gate"></div>
				</div>
				<label class="gate-slider">
					Trigger level
					<input type="range" id="tuner-gate" min="0.001" max="0.04" step="0.0005" />
				</label>
				<label class="gate-slider">
					Mic boost
					<input type="range" id="tuner-boost" min="0.5" max="8" step="0.1" />
				</label>
				<p class="gate-hint">Notes register when the bar passes the mark.</p>
			</div>
		</div>
	</section>

	<section id="view-metronome" class="view" hidden>
		<div class="card metronome-card">
			<div class="progress-row">
				<span class="metronome-title">Metronome</span>
				<button type="button" id="btn-metronome-back" class="btn btn-secondary btn-small">Back</button>
			</div>
			<div class="metronome-controls">
				<button type="button" id="btn-metronome-play" class="btn btn-primary metronome-play">Play</button>
				<div class="tempo-dial-wrap">
					<label class="tempo-dial-label">Tempo</label>
					<div id="tempo-dial" class="tempo-dial" tabindex="0" role="slider" aria-label="Tempo BPM" aria-valuemin="20" aria-valuemax="240" aria-valuenow="90">
						<div id="tempo-dial-knob" class="tempo-dial-knob"></div>
						<span id="metronome-bpm" class="tempo-dial-value">90</span>
						<span class="tempo-dial-unit">BPM</span>
					</div>
					<div class="tempo-stepper" role="group" aria-label="Adjust tempo">
						<button type="button" id="metronome-bpm-minus-5" class="btn btn-secondary btn-small stepper-btn tempo-stepper-btn-wide" aria-label="Decrease tempo by 5">−5</button>
						<button type="button" id="metronome-bpm-minus" class="btn btn-secondary btn-small stepper-btn" aria-label="Decrease tempo">−</button>
						<button type="button" id="metronome-bpm-plus" class="btn btn-secondary btn-small stepper-btn" aria-label="Increase tempo">+</button>
						<button type="button" id="metronome-bpm-plus-5" class="btn btn-secondary btn-small stepper-btn tempo-stepper-btn-wide" aria-label="Increase tempo by 5">+5</button>
					</div>
					<button type="button" id="btn-metronome-tap" class="btn btn-secondary tempo-tap-btn" aria-label="Tap tempo">Tap</button>
				</div>
				<div class="stepper-field">
					<label class="checkbox stepper-label-row">
						<input type="checkbox" id="metronome-beats-enabled" checked />
						<span class="stepper-label">Beats per measure</span>
					</label>
					<div class="stepper">
						<button type="button" id="metronome-beats-minus" class="btn btn-secondary btn-small stepper-btn" aria-label="Decrease beats">−</button>
						<input type="number" id="metronome-beats" class="stepper-input" min="1" max="16" value="4" readonly aria-label="Beats per measure" />
						<button type="button" id="metronome-beats-plus" class="btn btn-secondary btn-small stepper-btn" aria-label="Increase beats">+</button>
					</div>
				</div>
				<label class="gate-slider metronome-volume">
					Metronome volume
					<input type="range" id="metronome-volume" min="0" max="2" step="0.05" />
				</label>
			</div>
		</div>
	</section>

	<section id="view-drum" class="view" hidden>
		<div class="card drum-card">
			<div class="progress-row">
				<span class="drum-title">Drum machine</span>
				<button type="button" id="btn-drum-back" class="btn btn-secondary btn-small">Back</button>
			</div>
			<div class="drum-controls">
				<div class="drum-transport">
					<button type="button" id="btn-drum-play" class="btn btn-primary drum-play">Play</button>
					<button type="button" id="btn-drum-reset" class="btn btn-secondary">Reset</button>
				</div>
				<label class="gate-slider drum-tempo">
					Tempo
					<input type="range" id="drum-tempo" min="40" max="240" step="1" value="90" />
					<span id="drum-bpm" class="drum-bpm-readout">90 BPM</span>
				</label>
				<div class="drum-volumes" role="group" aria-label="Drum volumes">
					<label class="gate-slider drum-vol-slider">
						<span class="drum-vol-mark">M</span>
						<input type="range" id="drum-vol-master" min="0" max="2" step="0.05" value="1" aria-label="Master volume" />
					</label>
					<label class="gate-slider drum-vol-slider">
						<span class="drum-vol-mark">K</span>
						<input type="range" id="drum-vol-kick" min="0" max="2" step="0.05" value="1" aria-label="Kick volume" />
					</label>
					<label class="gate-slider drum-vol-slider">
						<span class="drum-vol-mark">S</span>
						<input type="range" id="drum-vol-snare" min="0" max="2" step="0.05" value="1" aria-label="Snare volume" />
					</label>
					<label class="gate-slider drum-vol-slider">
						<span class="drum-vol-mark">H</span>
						<input type="range" id="drum-vol-hihat" min="0" max="2" step="0.05" value="1" aria-label="Hi-hat volume" />
					</label>
				</div>
				<div class="drum-steppers">
					<div class="stepper-field">
						<span class="stepper-label">Beats</span>
						<div class="stepper">
							<button type="button" id="drum-beats-minus" class="btn btn-secondary btn-small stepper-btn" aria-label="Decrease beats">−</button>
							<input type="number" id="drum-beats" class="stepper-input" min="1" max="16" value="4" readonly aria-label="Beats" />
							<button type="button" id="drum-beats-plus" class="btn btn-secondary btn-small stepper-btn" aria-label="Increase beats">+</button>
						</div>
					</div>
					<div class="stepper-field">
						<span class="stepper-label">Sub-beats per beat</span>
						<div class="stepper">
							<button type="button" id="drum-subbeats-minus" class="btn btn-secondary btn-small stepper-btn" aria-label="Decrease sub-beats">−</button>
							<input type="number" id="drum-subbeats" class="stepper-input" min="1" max="16" value="4" readonly aria-label="Sub-beats per beat" />
							<button type="button" id="drum-subbeats-plus" class="btn btn-secondary btn-small stepper-btn" aria-label="Increase sub-beats">+</button>
						</div>
					</div>
				</div>
				<div id="drum-grid" class="drum-grid" aria-label="Step sequencer pattern"></div>
			</div>
		</div>
	</section>
</Layout>

<script>
	import '../../scripts/bass-tools/app.js';
</script>
