---
import Layout from '../../components/Layout.astro';
import '../../styles/bass-tools.css';

const description =
	'Note imitation and fretboard practice for bass. Hear a note and play it back, tap it on an on-screen fretboard, or name a highlighted fret.';
---

<Layout title="Ear Training for 5-String Bass" description={description}>
	<section id="view-home" class="view view-active">
		<header class="page-intro">
			<h1>Ear Training for 5-String Bass</h1>
			<p class="page-intro__desc">
				Practice in your configured range three ways: hear a note and play it back on your bass, tap it on the
				on-screen fretboard, or name a highlighted fret. Note names stay hidden until you match each one. Use
				headphones in play-back mode so the mic does not pick up the reference tones.
			</p>
			<div class="home-mode">
				<p class="home-start-label">Play it back on your bass</p>
				<div class="home-actions start-row">
					<button type="button" class="btn btn-primary btn-start" data-note-count="1" data-input="mic">
						1 note
					</button>
					<button type="button" class="btn btn-secondary btn-start" data-note-count="2" data-input="mic">
						2 notes
					</button>
					<button type="button" class="btn btn-secondary btn-start" data-note-count="3" data-input="mic">
						3 notes
					</button>
				</div>
			</div>
			<div class="home-mode">
				<p class="home-start-label">Find it on the fretboard</p>
				<div class="home-actions start-row">
					<button type="button" class="btn btn-primary btn-start" data-note-count="1" data-input="fretboard">
						1 note
					</button>
					<button type="button" class="btn btn-secondary btn-start" data-note-count="2" data-input="fretboard">
						2 notes
					</button>
					<button type="button" class="btn btn-secondary btn-start" data-note-count="3" data-input="fretboard">
						3 notes
					</button>
				</div>
			</div>
			<div class="home-mode">
				<p class="home-start-label">Name the note on the fretboard</p>
				<div class="home-actions start-row">
					<button type="button" class="btn btn-primary btn-start" data-note-count="1" data-input="name">
						Start
					</button>
				</div>
			</div>
			<div class="home-actions home-settings-row">
				<button type="button" id="btn-toggle-settings" class="btn btn-secondary">Settings</button>
			</div>
		</header>

		<form id="settings-form" class="card settings-panel hidden" aria-label="Settings">
			<h2>Settings</h2>
			<div class="field-grid">
				<label>
					Notes per set
					<input type="number" name="notesPerSet" min="1" max="500" required />
				</label>
				<label>
					Max interval in a sequence (semitones)
					<input type="number" name="maxIntervalSemitones" min="1" max="24" required />
				</label>
				<label class="gate-slider">
					Playback volume
					<input type="range" name="playbackVolume" min="0" max="2" step="0.05" />
				</label>
			</div>

			<details class="advanced">
				<summary>Advanced</summary>
				<div class="field-grid">
					<label>
						Microphone
						<select name="inputDeviceId" id="input-device-select">
							<option value="">Default</option>
						</select>
					</label>
					<label>
						Noise gate
						<input type="number" name="noiseGate" min="0.001" max="0.2" step="0.001" />
					</label>
					<label>
						Mic boost
						<input type="number" name="inputGain" min="0.5" max="8" step="0.1" />
					</label>
					<label>
						Cents tolerance
						<input type="number" name="centsTolerance" min="5" max="100" />
					</label>
					<label class="checkbox">
						<input type="checkbox" name="showLiveDetection" />
						Show live detection (debug)
					</label>
				</div>
			</details>

			<button type="submit" class="btn btn-primary">Save settings</button>
			<p id="settings-saved" class="hint hidden" role="status">Settings saved.</p>
		</form>
	</section>

	<section id="view-practice" class="view" hidden>
		<div class="card practice-card">
			<div class="progress-row">
				<span id="practice-progress">0 / 100</span>
				<button type="button" id="btn-stop" class="btn btn-secondary btn-small">Stop</button>
			</div>
			<p id="practice-status" class="practice-status">Listening…</p>
			<p id="practice-sequence" class="practice-sequence hidden" aria-live="polite"></p>
			<p id="practice-hint" class="practice-hint" aria-live="polite">
				<span class="hint-slot hint-slot-placeholder" aria-hidden="true">↑</span>
			</p>
			<p id="practice-live" class="practice-live hidden" aria-live="polite"></p>
			<div class="meter-wrap" id="mic-controls">
				<label class="meter-label">Mic level</label>
				<div class="meter">
					<div id="mic-meter" class="meter-fill"></div>
					<div id="mic-gate-mark" class="meter-gate"></div>
				</div>
				<label class="gate-slider">
					Trigger level
					<input type="range" id="mic-gate" min="0.001" max="0.04" step="0.0005" />
				</label>
				<label class="gate-slider">
					Mic boost
					<input type="range" id="mic-boost" min="0.5" max="8" step="0.1" />
				</label>
				<p class="gate-hint">Notes register when the bar passes the mark.</p>
			</div>
			<div class="fretboard-wrap hidden" id="fretboard-wrap">
				<div id="fretboard"></div>
			</div>
			<div id="note-name-pad" class="note-name-pad hidden" role="group" aria-label="Note names"></div>
			<label class="gate-slider practice-volume">
				Playback volume
				<input type="range" id="playback-volume" min="0" max="2" step="0.05" />
			</label>
			<div class="note-range-field practice-note-range">
				<label class="gate-slider">
					Notes covered
					<input type="range" id="note-range" min="1" max="12" step="1" />
				</label>
				<p id="note-range-preview" class="note-range-preview">3 — B, E, A</p>
			</div>
		</div>
	</section>

	<section id="view-results" class="view" hidden>
		<div class="card">
			<h2>Session complete</h2>
			<dl class="stats-grid" id="results-summary"></dl>
			<h3>Hardest notes</h3>
			<ul id="results-per-note" class="per-note-list"></ul>
			<button type="button" id="btn-home" class="btn btn-primary">Back home</button>
		</div>
	</section>
</Layout>

<script>
	import '../../scripts/bass-tools/ear-training-app.js';
</script>
